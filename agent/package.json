{
  "name": "xflow-agent",
  "version": "1.0.7",
  "description": "Reads Xray-core per-user traffic stats over gRPC and reports deltas to an xflow-collector aggregator, for feeding self-built nodes' usage into Sub-Store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekotaku/xflow.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/geekotaku/xflow/tree/main/agent#readme",
  "main": "dist/index.js",
  "bin": {
    "xflow-agent": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/bundle.js",
    "build:sea": "node scripts/build-sea.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
